# CodeScanning's exception registry lists weaknesses in the code, so it is never committed.
.repo-contract/exceptions/code-scanning.json

# A benchmark run outside CI is a gate, not a figure: only CI's results are committed.
/.benchmark-local

# Published figures, and the files beside them that say what each figure is: generated in CI, never committed.
/docs/coverage.json
/docs/mutation.json
/docs/size.json
/docs/*-badge.json
