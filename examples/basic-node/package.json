{
  "name": "env-cap-example-basic-node",
  "private": true,
  "type": "module",
  "description": "Minimal end-to-end example: capability-owned env.schema.ts files, a generated contract, and validateEnv() at startup.",
  "scripts": {
    "generate:env": "node scripts/generate-manifest.mjs",
    "typecheck": "npm run generate:env && tsc --noEmit",
    "start": "npm run generate:env && tsx --env-file=.env src/server.ts",
    "verify:env": "env-cap --include src/env.ts --location src/generated/env.manifest.ts --docs docs/ENVIRONMENT.md --env-example .env.example --ownership docs/OWNERSHIP.md --check"
  },
  "dependencies": {
    "@maverickcer/env-cap": "file:../.."
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  }
}