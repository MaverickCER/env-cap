# Fake but plausible values for local development and CI -- intentionally
# committed (see .gitignore's comment). None of these are real credentials.
# These values are never actually read: postgres and mongodb both ship
# active: true while sharing exclusiveGroup "database" (see both schemas),
# so generate:env always fails at the manifest step before any value is
# validated. Kept complete anyway, matching what "Fixing it" in README.md
# describes.

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
MONGODB_REPLICA_SET=rs0
