# AUTO-GENERATED EXAMPLE FILE.
# Copy to .env and fill in real values. Do not commit .env.

# Postgres connection string.
# Required: yes
# Setup: Provision a Postgres instance and paste its connection string, e.g. postgres://user:pass@host:5432/dbname.
DATABASE_URL=

# Minimum log level for this application's logger.
LOG_LEVEL=info

# Which payment provider this deployment uses.
# Setup: Set to "stripe" or "paypal" to match the gateway this deployment integrates.
PAYMENT_PROVIDER=stripe

# Database port.
PORT=5432

# Stripe secret key used to authenticate server-side API calls.
# Expires At: 2026-09-01
# Refresh Instructions: Rotate in the Stripe dashboard (Developers -> API keys), then redeploy. Rotate every 90 days.
# Required: yes
# Documentation: https://dashboard.stripe.com/apikeys
# Setup: Create a restricted API key in the Stripe dashboard.
STRIPE_KEY=
