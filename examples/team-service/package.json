{
  "name": "env-cap-example-team-service",
  "private": true,
  "type": "module",
  "description": "Multiple capability-owned env.schema.ts files (postgres, mongodb, prisma, auth), spanning two real teams, with a --check CI gate -- no central schema to edit when a capability is added, removed, or swapped.",
  "scripts": {
    "docs": "env-cap --location src/generated/env.manifest.ts --evidence docs/env.evidence.json",
    "docs:reports": "npm run docs && tsx scripts/generate-docs/run.ts",
    "check": "env-cap --location src/generated/env.manifest.ts --evidence docs/env.evidence.json --check && tsx scripts/generate-docs/check.ts",
    "typecheck": "npm run docs:reports && tsc --noEmit",
    "start": "npm run docs:reports && tsx --env-file=.env src/app.ts"
  },
  "dependencies": {
    "env-cap": "file:../.."
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  }
}
