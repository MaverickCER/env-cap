# AUTO-GENERATED EXAMPLE FILE.
# Copy to .env and fill in real values. Do not commit .env.

# Which database provider Prisma should target.
DATABASE_PROVIDER=

# Postgres connection string.
# Owner: security-team
# Setup: Request a scoped database credential from security-team's vault (see the runbook); do not reuse another service's connection string.
# Expires At: 2026-10-15
# Refresh Instructions: security-team rotates this credential quarterly via the vault; data-platform-team just needs to redeploy after a rotation lands.
DATABASE_URL=

# Signs and verifies user session cookies.
# Setup: Generate with `openssl rand -base64 32`; security-team keeps the canonical copy in the shared vault.
# Expires At: 2026-10-01
# Refresh Instructions: Rotate via the vault, then redeploy -- existing sessions are invalidated on rotation, so schedule outside peak hours.
# Required: yes
SESSION_SECRET=

# Disabled -- feature "mongodb" is not active.
# MongoDB replica set name -- no Postgres equivalent.
# MONGODB_REPLICA_SET=rs0
