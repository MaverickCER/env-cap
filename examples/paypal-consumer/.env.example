# AUTO-GENERATED EXAMPLE FILE.
# Copy to .env and fill in real values. Do not commit .env.

# Display name for this service, used in startup logs.
APP_NAME=paypal-consumer

# PayPal REST API client ID for this application's PayPal app.
# Setup: Create an app in the PayPal Developer Dashboard and copy its client ID.
PAYPAL_CLIENT_ID=

# PayPal REST API client secret.
# Expires At: 2027-01-01
# Refresh Instructions: Rotate in the PayPal Developer Dashboard, then redeploy.
# Required: yes
PAYPAL_CLIENT_SECRET=

# Webhook ID PayPal uses to sign event notifications sent to this app.
# Setup: Copy the webhook ID from the PayPal Developer Dashboard's Webhooks page.
PAYPAL_WEBHOOK_ID=

# Port this service listens on.
PORT=3000
