# Fake but plausible values for local development and CI -- intentionally
# committed (see .gitignore's comment) so this example's runtime behavior is
# actually exercised, not just its build/generation step. None of these are
# real credentials -- paypal-addon's placeholder checkout logic never makes a
# real PayPal API call.

APP_NAME=paypal-consumer
PAYPAL_CLIENT_ID=sandbox-client-id-placeholder
PAYPAL_CLIENT_SECRET=sandbox-client-secret-placeholder
PAYPAL_WEBHOOK_ID=sandbox-webhook-id-placeholder
PORT=3000
