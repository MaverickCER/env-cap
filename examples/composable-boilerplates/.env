# Fake but plausible values for local development and CI -- intentionally
# committed (see .gitignore's comment) so this example's runtime behavior is
# actually exercised, not just its build/generation step. None of these are
# real credentials. Postgres is the active backend by default (see
# features/postgres/env.schema.ts) -- mongodb's MONGODB_REPLICA_SET is
# omitted since that contract is inactive and not required by validateEnv().

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
