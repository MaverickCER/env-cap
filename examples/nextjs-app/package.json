{
  "name": "env-cap-example-nextjs",
  "private": true,
  "type": "module",
  "description": "A minimal Next.js todo app demonstrating a real NEXT_PUBLIC_* (client) vs. server-only environment variable boundary, enforced by env-cap's contract mechanism at next.config.ts load time -- before any client bundle compiles.",
  "scripts": {
    "docs": "env-cap --include \"src/features/**/env.*.schema.ts\" --location src/generated/env.manifest.ts --evidence docs/env.evidence.json",
    "docs:reports": "npm run docs && tsx scripts/generate-docs/run.ts",
    "check": "env-cap --include \"src/features/**/env.*.schema.ts\" --location src/generated/env.manifest.ts --evidence docs/env.evidence.json --check && tsx scripts/generate-docs/check.ts",
    "typecheck": "npm run docs:reports && tsc --noEmit",
    "dev": "npm run docs:reports && next dev",
    "build": "npm run docs:reports && tsx scripts/validate-env.ts && next build",
    "start": "next start"
  },
  "dependencies": {
    "@maverickcer/env-cap": "file:../..",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  }
}
