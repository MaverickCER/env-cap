{
  "$schema": "https://typedoc.org/schema.json",
  "extends": ["internal-package-contract/config/typedoc"],
  "entryPoints": [
    "src/runtime/index.ts",
    "src/build/index.ts",
    "src/helpers/index.ts",
    "src/evidence/index.ts",
    "src/node/index.ts",
    "src/eslint-plugin/index.ts"
  ],
  "out": "docs/api",
  "readme": "none",
  "treatValidationWarningsAsErrors": true,
  "requiredToBeDocumented": [
    "Enum",
    "EnumMember",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Method",
    "Accessor",
    "TypeAlias",
    "CallSignature"
  ],
  "intentionallyNotExported": [
    "UnwrapDefault",
    "RawCreateEnvCall",
    "RawDocumentEnvCall",
    "ImportResolutionContext",
    "DiscoverOptions",
    "CatalogContract",
    "RuleOptions",
    "ExpiryBearingContract",
    "SarifResult",
    "VariableOf"
  ]
}
