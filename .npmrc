# Always attach a provenance attestation on publish, regardless of whether
# `npm publish` is invoked directly or wrapped by `changeset publish` (which
# doesn't expose a way to pass extra npm flags through). With OIDC trusted
# publishing (see .github/workflows/release.yml) this is attached
# automatically anyway, but setting it here is a harmless, explicit safety
# net -- some real-world reports show it mattering despite the docs saying
# it's automatic. See ADOPTION.md's supply-chain section.
provenance=true
