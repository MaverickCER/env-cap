node_modules
# dist and *.tgz are the addon's own build/pack artifacts (regenerated by
# `npm run build`/`pack:local`), the same category as node_modules -- unlike
# them, everything env-cap itself generates (docs/, src/generated/,
# .env.example) stays committed, since we want to show that output in this
# example repo.
dist
*.tgz
!.env
