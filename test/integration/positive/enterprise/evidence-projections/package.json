{
  "name": "env-cap-example-evidence-projections",
  "private": true,
  "type": "module",
  "description": "Eleven first-party reference projections (ADR 0024/0031/0032; the eleventh, Joined Variable View, added afterward as a copyable cross-model join example) built entirely through env-cap's public API -- generateEvidenceModel() from /build, defineEvidenceProjection() from /evidence -- with no privileged internal access, the same two entry points any consumer would import.",
  "scripts": {
    "generate:env": "node scripts/generate-manifest.mjs",
    "typecheck": "npm run generate:env && tsc --noEmit",
    "project:env-example": "npm run generate:env && node scripts/project-env-example.mjs",
    "project:config-reference": "npm run generate:env && node scripts/project-config-reference.mjs",
    "project:inventory": "npm run generate:env && node scripts/project-inventory.mjs",
    "project:ownership": "npm run generate:env && node scripts/project-ownership.mjs",
    "project:lifecycle": "npm run generate:env && node scripts/project-lifecycle.mjs",
    "project:dependency-graph": "npm run generate:env && node scripts/project-dependency-graph.mjs",
    "project:findings": "npm run generate:env && node scripts/project-findings.mjs",
    "project:drift": "npm run generate:env && node scripts/project-drift.mjs",
    "project:migration": "npm run generate:env && node scripts/project-migration.mjs",
    "project:change-impact-audit-trail": "npm run generate:env && node scripts/project-change-impact-audit-trail.mjs",
    "project:change-impact-blast-radius": "npm run generate:env && node scripts/project-change-impact-blast-radius.mjs",
    "project:joined-variables": "npm run generate:env && node scripts/project-joined-variables.mjs"
  },
  "dependencies": {
    "env-cap": "file:../../../../.."
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
