# Copy to .env and fill in real values. Do not commit .env.
# Validation context annotations describe when validation participates.
# They do not restrict access to values, and every variable below is
# still written to this file regardless of its context.

# Postgres connection string. Server-only: never read from a browser bundle.
# Validation context: server
# Owner: team-platform
# Required: yes
DATABASE_URL=

# Log verbosity. No validation context -- read by both the server and the client bundle.
# Owner: team-platform
LOG_LEVEL=info

# Public API base URL. Safe to expose to the browser.
# Validation context: client
# Owner: team-platform
# Required: yes
PUBLIC_API_URL=
