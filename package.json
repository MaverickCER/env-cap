{
  "name": "@maverickcer/env-cap",
  "version": "0.6.0",
  "description": "Secure, type-safe, framework-agnostic environment contracts. Contracts own the environment variables they consume; the package provides runtime validation and build-time contract discovery.",
  "keywords": [
    "environment",
    "env",
    "config",
    "configuration",
    "documentation",
    "validation",
    "typescript",
    "schema",
    "secrets",
    "dotenv"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaverickCER/env-cap.git"
  },
  "homepage": "https://maverickcer.github.io/env-cap/",
  "bugs": {
    "url": "https://github.com/MaverickCER/env-cap/issues"
  },
  "author": "MaverickCER",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./build": {
      "import": {
        "types": "./dist/build.d.ts",
        "default": "./dist/build.js"
      },
      "require": {
        "types": "./dist/build.d.cts",
        "default": "./dist/build.cjs"
      }
    },
    "./helpers": {
      "import": {
        "types": "./dist/helpers.d.ts",
        "default": "./dist/helpers.js"
      },
      "require": {
        "types": "./dist/helpers.d.cts",
        "default": "./dist/helpers.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./evidence": {
      "import": {
        "types": "./dist/evidence.d.ts",
        "default": "./dist/evidence.js"
      },
      "require": {
        "types": "./dist/evidence.d.cts",
        "default": "./dist/evidence.cjs"
      }
    },
    "./eslint-plugin": {
      "import": {
        "types": "./dist/eslint-plugin/index.d.ts",
        "default": "./dist/eslint-plugin/index.js"
      },
      "require": {
        "types": "./dist/eslint-plugin/index.d.cts",
        "default": "./dist/eslint-plugin/index.cjs"
      }
    },
    "./schema": "./schemas/env-cap-report.schema.json",
    "./schema/*": "./schemas/*.schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "env-cap": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "*.md",
    "specs/**/*.md",
    "skills/**/*.md",
    "benchmarks/**/*.md",
    "examples/README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsup && tsc -p tsconfig.build.json && node scripts/emit-dts-shims.mjs && node scripts/fix-eslint-plugin-cjs-interop.mjs",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typescript-compat": "node scripts/typescript-compat.mjs",
    "verify:compiler-isolation": "node scripts/verify-compiler-isolation.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "contract": "npm run docs:benchmarks && internal-package-contract",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "npm install && npm run build && npm run schema",
    "size": "node scripts/check-size.mjs",
    "verify:no-ambient-fs": "node scripts/verify-no-ambient-fs.mjs",
    "verify:no-ambient-child-process": "node scripts/verify-no-ambient-child-process.mjs",
    "schema": "node scripts/generate-json-schema.mjs",
    "examples:update-golden": "node scripts/update-example-goldens.mjs",
    "benchmark": "node scripts/run-benchmarks.mjs",
    "docs:api": "typedoc",
    "docs:api:report": "typedoc --options typedoc.markdown.json",
    "docs:api:report:check": "node scripts/check-api-report.mjs",
    "docs:benchmarks": "node node_modules/internal-package-contract/scripts/benchmark/render-page.mjs --out docs/benchmarks/index.html --readme https://github.com/maverickcer/env-cap/blob/main/benchmarks/README.md --history \"Runtime|benchmarks/history/runtime.json\" --history \"Build-time|benchmarks/history/buildtime.json\"",
    "verify:readme-example": "node scripts/check-readme-example-fresh.mjs",
    "stage": "npm run typecheck && npm run build && npm run test && npm run size",
    "precommit": "npm run typecheck && npm run lint && npm run format && npm run build && npm run schema && npm run test:coverage && npm run size && npm run verify:no-ambient-fs && npm run verify:no-ambient-child-process && npm run verify:compiler-isolation && npm run docs:api:report:check && npm run verify:readme-example",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run schema && npm run test:coverage && npm run size && npm run verify:no-ambient-fs && npm run verify:no-ambient-child-process && npm run verify:compiler-isolation && npm run docs:api:report:check && npm run verify:readme-example",
    "prepublishOnly": "npm run verify",
    "version": "changeset version && npm run build && npm run examples:update-golden",
    "release": "changeset publish",
    "benchmark:check": "node scripts/run-benchmarks.mjs --check"
  },
  "dependencies": {
    "@typescript/typescript6": "^6.0.2"
  },
  "bundleDependencies": [
    "@typescript/typescript6",
    "@typescript/old"
  ],
  "peerDependencies": {
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0",
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "@typescript-eslint/utils": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/utils": "^8.65.0",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.9.0",
    "internal-package-contract": "github:MaverickCER/internal-package-contract#v0.10.0",
    "prettier": "3.9.9",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.6",
    "nanoid": "^3.3.18",
    "tar": "^7.5.22",
    "pa11y": {
      "puppeteer": "npm:puppeteer-core@^25.9.0"
    },
    "adm-zip": "0.6.1",
    "qs": "6.16.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  },
  "internal-package-contract": {
    "apiTargets": {
      ".": "src/runtime/index.ts"
    }
  }
}
